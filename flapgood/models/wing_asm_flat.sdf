<?xml version="1.0"?>
<sdf version="1.7">
    <model name="four_bar">
        <link name='driving_link'>
            <!-- <pose relative_to='driving_joint'>0 0 0 0 0 0</pose> -->
            <inertial>
                <pose>0.01915 0 0 0 0 0</pose>
                <mass>0.00016893</mass>
                <inertia>
                    <ixx>6.334875e-11</ixx>
                    <iyy>2.068181835e-08</iyy>
                    <izz>2.068181835e-08</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>
            <visual name='driving_link_visual'>
                <pose>0.01915 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.0383 0.0015 0.0015</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>.7 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="drive_link_pivot_visual">
                <!-- Rotation around Ax by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0005</radius>
                        <length>0.005</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>


        <link name='humerus'>
            <pose relative_to='driving_link'>0.03830 0 0 0 0 0</pose>
            <inertial>
                <pose>0.019 0 0 0 0 0</pose>
                <mass>0.00016893</mass>
                <inertia>
                    <ixx>6.334875e-11</ixx>
                    <iyy>2.2555674375e-08</iyy>
                    <izz>2.2555674375e-08</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>
            <visual name='humerus_visual'>
                <pose>0.019 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.04 0.0015 0.0015 </size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0 .7 0 1</diffuse>
                </material>
            </visual>
            <visual name="humerus_pivot_visual">
                <!-- Rotation around Bx by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0005</radius>
                        <length>0.005</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
            <visual name="CouplerPoint">
                <!-- Translation down Bx by 2 and down Bz by -2 -->
                <pose relative_to="humerus">-.019 0 -.019 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.002</radius>
                    </sphere>
                </geometry>
                <material>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
        </link>


        <link name='radius'>
            <pose>-0.005972 0 0.01403177573 0 0 0</pose>
            <inertial>
                <pose>0.025 0 0 0 0 0</pose>
                <mass>0.00071232</mass>
                <inertia>
                    <ixx>1.5461999999999998e-10</ixx>
                    <iyy>8.597731000000002e-08</iyy>
                    <izz>8.597731000000002e-08</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>
            <visual name='radius_visual'>
                <pose>0.025 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.05 0.0015 0.0015</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0 0 .7 1</diffuse>
                </material>
            </visual>

            <visual name="radius_pivot_visual">
                <!-- Rotation around Cx by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0005</radius>
                        <length>0.01</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>

        <joint name="driving_joint" type="revolute">
            <parent>world</parent>
            <child>driving_link</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <!-- <effort>0</effort> -->
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name='humerus_joint' type='revolute'>
            <!-- <pose relative_to='driving_link'>0 0.0 -0.03830 0 1.57 0</pose> -->
            <parent>driving_link</parent>
            <child>humerus</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <!-- <frame name="world_radial_anchor" attached_to="__model__">
      <pose relative_to="__model__">0.005972 0 0.01403177573 -3.141585307179587 -0.93281 -1.5708</pose>
    </frame> -->
        <joint name='mid_radial_joint' type='revolute'>
            <parent>world</parent>
            <child>radial_world_anchor</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0</damping>
                </dynamics>
            </axis>
        </joint>
        <frame name="radial_world_anchor" attached_to="radius">
            <pose relative_to="radius">0 0 0 0 0 0</pose>
        </frame>


        <frame name="humerus_radial_bushing" attached_to="humerus">
            <pose relative_to="humerus">0.04 0 0 -1.57079632679 0 0 </pose>
        </frame>
        <frame name="radial_humerus_bushing" attached_to="radius">
            <pose relative_to="radius">0.04 0 0 -1.57079632679 0 0</pose>
        </frame>
    </model>
</sdf>