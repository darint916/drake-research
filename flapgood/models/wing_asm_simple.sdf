<?xml version="1.0"?>
<sdf version="1.7">
  <model name="four_bar">
    <link name='driving_link'>
      <!-- <pose relative_to='driving_joint'>0 0 0 0 0 0</pose> -->
      <inertial>
        <pose>0 0 -0.01915 0 0 0</pose>
        <mass>0.00016893</mass>
        <inertia>
          <ixx>2.067389975625e-08</ixx>
          <iyy>2.067389975625e-08</iyy>
          <izz>4.75115625e-11</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name='driving_link_visual'>
        <pose>0 0 -0.01915 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00075</radius>
            <length>0.0383</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>.7 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name='humerus_joint' type='revolute'>
      <pose relative_to='driving_link'>0 0.0 -0.03830 0 1.57 0</pose>
      <parent>driving_link</parent>
      <child>humerus</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <effort>0</effort>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0.000</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name='humerus'>
      <pose relative_to='driving_link'>0 0.0 -0.03830 0 1.57 0</pose>
      <inertial>
        <pose>0 0 -0.02 0 0 0</pose>
        <mass>0.00016893</mass>
        <inertia>
          <ixx>2.2547755781250002e-08</ixx>
          <iyy>2.2547755781250002e-08</iyy>
          <izz>4.75115625e-11</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name='humerus_visual'>
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00075</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0 .7 0 1</diffuse>
        </material>
      </visual>
    </link>


    <link name='radius'>
      <pose relative_to='humerus'>0 0 -0.04 0 -1.57 0 </pose>
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>0.00071232</mass>
        <inertia>
          <ixx>5.937001700000001e-07</ixx>
          <iyy>5.937001700000001e-07</iyy>
          <izz>2.0034e-10</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name='radius_visual'>
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.00075</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0 0 .7 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Replaced by bushign -->
    <!-- <joint name='radial_joint' type='revolute'>
      <parent>humerus</parent>
      <child>radius</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
