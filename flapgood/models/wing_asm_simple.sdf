          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0.00001</spring_stiffness>
        </dynamics>
      </axis>
    </joint> -->

    <frame name="radial_world_anchor" attached_to="radius">
      <pose relative_to="radius">0 0 0.0383 0 0 0</pose>
    </frame>
    <!-- <frame name="world_radial_anchor" attached_to="__model__">
      <pose relative_to="__model__">0.005972 0 0.01403177573 -3.141585307179587 -0.93281 -1.5708</pose>
    </frame> -->
    <joint name='mid_radial_joint' type='revolute'>
      <parent>world</parent>
      <child>radial_world_anchor</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>0</effort>
        </limit>
        <!-- <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit> -->
        <dynamics>
          <damping>0</damping>
          <spring_stiffness>0.0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <joint name="driving_joint" type="revolute">
      <parent>world</parent>
      <child>driving_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <!-- <limit>
          <effort>0</effort>
        </limit> -->
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
        <dynamics>
          <spring_stiffness>0.00000001</spring_stiffness>
          <damping>0.00000001</damping>
        </dynamics>
      </axis>
    </joint>

    <frame name="humerus_radial_bushing" attached_to="humerus">
      <pose relative_to="humerus">0 0 -0.04 0 0 0 </pose>
    </frame>
    <frame name="radial_humerus_bushing" attached_to="radius">
      <pose relative_to="radius">0 0 0 0 0 0</pose>
    </frame>
  </model>
</sdf>