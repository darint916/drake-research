<?xml version="1.0"?>
<sdf version="1.7">
    <model name="four_bar">
        <link name="A">
            <!-- The frame A measured in the world frame, X_WA is the identity. This 
      link is also called 'Crank' in the diagram in README.md -->
            <inertial>
                <!-- Acm (A's center of mass) is located at the midpoint of the 4 meter long link. -->
                <pose>1 0 0 0 0 0</pose>
                <mass>144</mass>
                <inertia>
                    <!-- Inertia tensor for a solid cuboid of dimensions
          (l, w, h) = (4.2 m, 0.1 m, 0.2 m) and mass 20 kg-->
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <!-- A skinny red box along the Ax axis -->
            <visual name="A_visual">
                <pose>1 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>2 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <!-- A visual representing the revolute joint between the world and
       link A. -->
            <visual name="A_pivot_visual">
                <!-- Rotation around Ax by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.15</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>
        <link name="B">
            <!-- The frame B measured in A, X_AB, is a translation along the Ax
      axis, and a small translation along the Ay (revolute) axis for visual
      purposes. This link is also called 'Coupler' in the diagram in README.md -->
            <pose relative_to="A">2 0 0 0 0 0</pose>
            <inertial>
                <!-- Bcm (B's center of mass) is located at the midpoint of the 4 meter long link. -->
                <pose>1.9 0 0 0 0 0</pose>
                <mass>140</mass>
                <inertia>
                    <!-- Inertia tensor for a solid cuboid of dimensions
          (l, w, h) = (4.2 m, 0.1 m, 0.2 m) and mass 20 kg-->
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <!-- A skinny blue box along the Bx axis -->
            <visual name="B_visual">
                <pose>1.9 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>4 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <!-- A visual representing the revolute joint between
      link A and link B.  -->
            <visual name="B_pivot_visual">
                <!-- Rotation around Bx by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 -0.05 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.25</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
            <!-- A visual representing the 'Coupler-Point' P -->
            <visual name="CouplerPoint">
                <!-- Translation down Bx by 2 and down Bz by -2 -->
                <pose relative_to="B">2 0 -2 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.1</radius>
                    </sphere>
                </geometry>
                <material>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <visual name="B_frame_anchor_visual">
                <pose relative_to="Bf_bushing">0 0 0 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="C">
            <!-- <pose>0.5972 0 1.403 0 0 0</pose> -->
            <pose>1.5972 0 3.403 0 0 0</pose>
            <!-- <pose>1.1944 0 2.806 0 0 0</pose> -->
            <inertial>
                <pose>2.5 0 0 0 0 0</pose>
                <mass>140</mass>
                <inertia>
                    <!-- Inertia tensor for a solid cuboid of dimensions
          (l, w, h) = (4.2 m, 0.1 m, 0.2 m) and mass 20 kg-->
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <!-- A skinny yellow box along the Bx axis -->
            <visual name="C_visual">
                <pose>2.5 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>5 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>1 1 0 1</diffuse>
                </material>
            </visual>
            <!-- A visual representing the revolute joint between the world
      and link C.  -->
            <visual name="C_pivot_visual">
                <!-- Rotation around Cx by 90° = π/2 radians ≈ 1.57079632679 -->
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.15</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="D">
            <pose relative_to="C">0 0 0 0 0 0</pose>
            <inertial>
                <pose>-2.5 0 0 0 0 0</pose>
                <mass>140</mass>
                <inertia>
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <visual name="D_visual">
                <pose>-2.5 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>5 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>1 .5 1 1</diffuse>
                </material>
            </visual>
            <visual name="D_pivot_visual">
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.15</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>


        <link name="E">
            <pose relative_to="D">-5 0 0 0 1.57079632679 0</pose>
            <inertial>
                <pose>-1 0 0 0 0 0</pose>
                <mass>140</mass>
                <inertia>
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <visual name="E_visual">
                <pose>-1 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>2 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>1 1 1 1</diffuse>
                </material>
            </visual>
            <visual name="E_pivot_visual">
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.15</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="F">
            <pose relative_to="E">-2 0 0 0 1.57079632679 0</pose>
            <inertial>
                <pose>-5 0 0 0 0 0</pose>
                <mass>140</mass>
                <inertia>
                    <ixx>0.08333333333333334</ixx>
                    <iyy>29.46666666666666</iyy>
                    <izz>29.416666666666668</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <visual name="F_visual">
                <pose>-5 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>10 0.15 0.15</size>
                    </box>
                </geometry>
                <material>
                    <diffuse>0 1 1 1</diffuse>
                </material>
            </visual>
            <visual name="F_pivot_visual">
                <pose>0 0 0 1.57079632679 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.15</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                </material>
            </visual>
            <visual name="F_frame_anchor_visual">
                <pose relative_to="Fb_bushing">0 0 0 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.01</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
        </link>

        <joint name="joint_EF" type="revolute">
            <parent>E</parent>
            <child>F</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name="joint_DE" type="revolute">
            <parent>D</parent>
            <child>E</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name="joint_CD" type="fixed">
            <parent>C</parent>
            <child>D</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name="joint_WA" type="revolute">
            <parent>world</parent>
            <child>A</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <!-- <effort>0</effort> -->
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>
        <joint name="joint_AB" type="revolute">
            <parent>A</parent>
            <child>B</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>
        <joint name="joint_WC" type="revolute">
            <parent>world</parent>
            <child>C</child>
            <axis>
                <xyz expressed_in="__model__">0 1 0</xyz>
                <limit>
                    <effort>0</effort>
                </limit>
                <dynamics>
                    <damping>0.0</damping>
                </dynamics>
            </axis>
        </joint>

        <frame name="Bf_bushing" attached_to="B">
            <pose relative_to="B">2 0 0 -1.57079632679 0 0</pose>
        </frame>

        <frame name="Fb_bushing" attached_to="F">
            <pose relative_to="F">-10 0 0 -1.57079632679 0 0</pose>
        </frame>

        <frame name="Bc_bushing" attached_to="B">
            <pose relative_to="B">4 0 0 -1.57079632679 0 0</pose>
        </frame>

        <frame name="Cb_bushing" attached_to="C">
            <pose relative_to="C">5 0 0 -1.57079632679 0 0</pose>
        </frame>
    </model>
</sdf>